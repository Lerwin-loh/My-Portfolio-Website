<div id="{{id}}" class="carousel slide" data-bs-ride="carousel">
  <div class="carousel-indicators">
    {{#each images}}
    <button type="button" data-bs-target="#{{../id}}" data-bs-slide-to="{{@index}}" class="{{#if @first}} active {{/if}}" style="background-color: #5e5e5e;"></button>
    {{/each}}
  </div>
  <div class="carousel-inner">
    {{#each images}}
    <div class="carousel-item {{#if @first}} active {{/if}}">
      <a href="{{this}}" target="_blank">
        <img src="{{this}}" alt="" class="proj_image d-block w-100">
      </a>
      <div class="carousel-caption">
        <p style="color: #5e5e5e; text-shadow: 0px 5px 5px #d1d1d1;">{{@key}}</p>
      </div>
    </div>
    {{/each}}
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#{{id}}" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" style="background-color: #5e5e5e83; border-radius:30px;"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#{{id}}" data-bs-slide="next">
    <span class="carousel-control-next-icon" style="background-color: #5e5e5e83; border-radius:30px;"></span>
  </button>
</div>
